{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "bBlocks",
	"templateParts": [
		{
			"name": "header",
			"title": "Header (Logo + Navigation)",
			"area": "header"
		},
		{
			"name": "header-cta",
			"title": "Header (Logo + Navigation + CTA)",
			"area": "header"
		},
		{
			"name": "header-centered",
			"title": "Header (Centered Logo + Navigation)",
			"area": "header"
		},
		{
			"name": "header-topbar",
			"title": "Header (Top Bar + Navigation + CTA)",
			"area": "header"
		},
		{
			"name": "header-search",
			"title": "Header (Logo + Navigation + Search)",
			"area": "header"
		},
		{
			"name": "header-mega-services",
			"title": "Header (Mega Menu: Services)",
			"area": "header"
		},
		{
			"name": "header-mega-shop",
			"title": "Header (Mega Menu: Shop)",
			"area": "header"
		},
		{
			"name": "header-mega-solutions",
			"title": "Header (Mega Menu: Solutions)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer (Simple)",
			"area": "footer"
		},
		{
			"name": "footer-columns",
			"title": "Footer (3 Columns)",
			"area": "footer"
		},
		{
			"name": "footer-social",
			"title": "Footer (4 Columns + Social)",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing Page (Full Width)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-blank",
			"title": "Blank Canvas (No Header or Footer)",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "page-no-title",
			"title": "Page No Title",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-with-sidebar",
			"title": "Page with Sidebar",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-with-wide-image",
			"title": "Page with Wide Image",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "single-with-sidebar",
			"title": "Post with Sidebar",
			"postTypes": [
				"post"
			]
		},
		{
			"name": "single-cover",
			"title": "Post with Cover Image",
			"postTypes": [
				"post"
			]
		}
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "768px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#f5f6f8",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e3e6ea",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#14171a",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#666e75",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#2954e3",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#0ea5a4",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#f59e0b",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #2954e3 0%, #0ea5a4 100%)",
					"name": "Primary to Secondary"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "mona-sans",
					"name": "Mona Sans",
					"fontFamily": "\"Mona Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Mona Sans",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontStretch": "100%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mona-sans-vf.woff2"
							]
						},
						{
							"fontFamily": "Mona Sans",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontStretch": "100%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mona-sans-italic-vf.woff2"
							]
						}
					]
				},
				{
					"slug": "mona-sans-condensed",
					"name": "Mona Sans Condensed",
					"fontFamily": "\"Mona Sans Condensed\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Mona Sans Condensed",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontStretch": "75%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mona-sans-vf.woff2"
							]
						},
						{
							"fontFamily": "Mona Sans Condensed",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontStretch": "75%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mona-sans-italic-vf.woff2"
							]
						}
					]
				},
				{
					"slug": "mona-sans-expanded",
					"name": "Mona Sans Expanded",
					"fontFamily": "\"Mona Sans Expanded\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Mona Sans Expanded",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontStretch": "125%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mona-sans-vf.woff2"
							]
						},
						{
							"fontFamily": "Mona Sans Expanded",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontStretch": "125%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mona-sans-italic-vf.woff2"
							]
						}
					]
				},
				{
					"slug": "mona-sans-narrow",
					"name": "Mona Sans Narrow",
					"fontFamily": "\"Mona Sans Narrow\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Mona Sans Narrow",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontStretch": "87.5%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mona-sans-vf.woff2"
							]
						},
						{
							"fontFamily": "Mona Sans Narrow",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontStretch": "87.5%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mona-sans-italic-vf.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.0625rem",
					"name": "Medium (Body)"
				},
				{
					"slug": "large",
					"size": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.6rem, 1.4rem + 1vw, 2.25rem)",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2rem, 1.6rem + 2vw, 3rem)",
					"name": "XX Large"
				},
				{
					"slug": "huge",
					"size": "clamp(2.5rem, 1.9rem + 3vw, 4rem)",
					"name": "Huge"
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "small",
					"size": "1rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.5rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "2.5rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "4rem",
					"name": "Extra Large"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"blocks": {
			"core/post-featured-image": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--mona-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--small)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--small)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mona-sans)",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "800",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "800",
					"lineHeight": "1.15"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "700"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "0.5rem"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--foreground)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted-text)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "800",
					"fontSize": "1.35rem",
					"letterSpacing": "-0.01em"
				}
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border-color)"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "normal"
				},
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"width": "0",
					"style": "solid"
				}
			},
			"core/details": {
				"border": {
					"color": "var(--wp--preset--color--border-color)",
					"width": "1px",
					"radius": "0.75rem"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)"
				}
			}
		}
	}
}
