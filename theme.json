{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "bBlocks",
	"templateParts": [
		{
			"name": "header",
			"title": "Header (Logo + Navigation)",
			"area": "header"
		},
		{
			"name": "header-cta",
			"title": "Header (Logo + Navigation + CTA)",
			"area": "header"
		},
		{
			"name": "header-centered",
			"title": "Header (Centered Logo + Navigation)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer (Simple)",
			"area": "footer"
		},
		{
			"name": "footer-columns",
			"title": "Footer (3 Columns)",
			"area": "footer"
		},
		{
			"name": "footer-social",
			"title": "Footer (4 Columns + Social)",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing Page (Full Width)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-no-title",
			"title": "Page No Title",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-with-sidebar",
			"title": "Page with Sidebar",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-with-wide-image",
			"title": "Page with Wide Image",
			"postTypes": [
				"page"
			]
		}
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "768px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#f5f6f8",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e3e6ea",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#14171a",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#666e75",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#2954e3",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#0ea5a4",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#f59e0b",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #2954e3 0%, #0ea5a4 100%)",
					"name": "Primary to Secondary"
				}
			]
		},
