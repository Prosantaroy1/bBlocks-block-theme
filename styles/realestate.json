{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Homely",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#fdfbf7",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#f3ece0",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e4dacb",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#2b2b2b",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#6b655c",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#1f4d3a",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#2f6b52",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#b5562f",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #1f4d3a 0%, #2f6b52 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--foreground)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "700",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "0.5rem"
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				}
			}
		}
	}
}
