{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Modern",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "background", "color": "#ffffff", "name": "Background" },
				{ "slug": "surface", "color": "#f7f5ff", "name": "Surface" },
				{ "slug": "border-color", "color": "#e6e1f5", "name": "Border" },
				{ "slug": "text", "color": "#17151f", "name": "Text" },
				{ "slug": "muted-text", "color": "#6b6775", "name": "Muted Text" },
				{ "slug": "primary", "color": "#6d28d9", "name": "Primary" },
				{ "slug": "secondary", "color": "#10b981", "name": "Secondary" },
				{ "slug": "accent", "color": "#f43f5e", "name": "Accent" }
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #6d28d9 0%, #10b981 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--secondary)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": { "radius": "999px" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--text)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		}
	}
}
