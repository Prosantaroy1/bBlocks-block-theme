{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Savora",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "background", "color": "#faf6ef", "name": "Background" },
				{ "slug": "surface", "color": "#f3ebdf", "name": "Surface" },
				{ "slug": "border-color", "color": "#e4d8c7", "name": "Border" },
				{ "slug": "foreground", "color": "#2a2522", "name": "Text" },
				{ "slug": "muted-text", "color": "#6b5f56", "name": "Muted Text" },
				{ "slug": "primary", "color": "#a13f2b", "name": "Primary" },
				{ "slug": "secondary", "color": "#6e2a2a", "name": "Secondary" },
				{ "slug": "accent", "color": "#9a8a3c", "name": "Accent" }
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #a13f2b 0%, #6e2a2a 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--foreground)" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)",
					"fontWeight": "600",
					"letterSpacing": "-0.005em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "6px"
				},
				"typography": {
					"fontWeight": "600",
					"textTransform": "none",
					"letterSpacing": "0.01em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)"
				}
			}
		}
	}
}
