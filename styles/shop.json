{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Shoplane",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#f4f4f5",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e4e4e7",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#111111",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#5f6068",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#111111",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#2a2a2e",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#ff5a4e",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #111111 0%, #2a2a2e 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--foreground)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--foreground)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)"
				}
			}
		}
	}
}
