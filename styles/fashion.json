{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Modista",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#faf7f2",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#f1ebe2",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e3dacd",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#151413",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#6b635b",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#111111",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#8a5a44",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#d8b4a0",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #111111 0%, #8a5a44 100%)",
					"name": "Primary to Secondary"
				}
			]
		},
		"custom": {
			"button-radius": "0"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)",
					"fontWeight": "500",
					"letterSpacing": "-0.01em",
					"textTransform": "none"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "500"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "500"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)"
				}
			}
		}
	}
}
