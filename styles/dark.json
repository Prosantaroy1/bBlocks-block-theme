{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "background", "color": "#0f1115", "name": "Background" },
				{ "slug": "surface", "color": "#171a21", "name": "Surface" },
				{ "slug": "border-color", "color": "#2a2e37", "name": "Border" },
				{ "slug": "text", "color": "#f3f4f6", "name": "Text" },
				{ "slug": "muted-text", "color": "#9aa1ac", "name": "Muted Text" },
				{ "slug": "primary", "color": "#5b8def", "name": "Primary" },
				{ "slug": "secondary", "color": "#2dd4bf", "name": "Secondary" },
				{ "slug": "accent", "color": "#fbbf24", "name": "Accent" }
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #5b8def 0%, #2dd4bf 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--secondary)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--text)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		}
	}
}
