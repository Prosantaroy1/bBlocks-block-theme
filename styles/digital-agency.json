{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Kindred",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#f6f4ef",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#ebe7dd",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#d6d0c2",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#141414",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#5a5750",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#c2410c",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#141414",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#d4f25c",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #c2410c 0%, #141414 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--mona-sans)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mona-sans-expanded)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--foreground)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.6rem",
						"right": "1.6rem"
					}
				},
				"typography": {
					"fontSize": "0.9375rem",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "#ffffff"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mona-sans-expanded)",
					"fontWeight": "700"
				}
			}
		}
	}
}
