{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumen",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "background", "color": "#0d0d0c", "name": "Background" },
				{ "slug": "surface", "color": "#171614", "name": "Surface" },
				{ "slug": "border-color", "color": "#2b2926", "name": "Border" },
				{ "slug": "foreground", "color": "#f2ede4", "name": "Text" },
				{ "slug": "muted-text", "color": "#a9a196", "name": "Muted Text" },
				{ "slug": "primary", "color": "#d9a85b", "name": "Primary" },
				{ "slug": "secondary", "color": "#b8853a", "name": "Secondary" },
				{ "slug": "accent", "color": "#ecd3a2", "name": "Accent" }
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #d9a85b 0%, #b8853a 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--foreground)" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "500",
					"letterSpacing": "-0.01em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--foreground)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				}
			}
		}
	}
}
