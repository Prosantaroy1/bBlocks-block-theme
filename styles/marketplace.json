{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "DigiMagnet",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#f5f7f8",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e5e8eb",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#0f1115",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#6b7280",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#a6e3c9",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#111317",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#7c5cff",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #a6e3c9 0%, #7c5cff 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--muted-text)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--foreground)"
				},
				"border": {
					"radius": "0.5rem"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--foreground)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)"
				}
			}
		}
	}
}
