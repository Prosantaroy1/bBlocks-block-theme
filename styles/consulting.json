{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Conselta",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#fbf7ec",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e8e2d2",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#111111",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#6b6b6b",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#f6c624",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#161616",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#f6c624",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #161616 0%, #2b2b2b 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--muted-text)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "600"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "600"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--foreground)"
				},
				"border": {
					"radius": "0.4rem"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--foreground)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				}
			}
		}
	}
}
