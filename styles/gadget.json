{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Voltix",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#f3f5f9",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#dfe4ec",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#0d1220",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#566074",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#1d4ed8",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#0b1b4f",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#c4f135",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #1d4ed8 0%, #0b1b4f 100%)",
					"name": "Primary to Secondary"
				}
			]
		},
		"custom": {
			"button-radius": "999px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "800",
					"letterSpacing": "-0.02em",
					"textTransform": "none"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontWeight": "700"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "800"
				}
			}
		}
	}
}
