{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Justica",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#fbf8f1",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#f3eee2",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e3dac7",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#26292e",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#5c6066",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#15233f",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#2b3d63",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#b08d4f",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #15233f 0%, #2b3d63 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)",
					"fontWeight": "700",
					"letterSpacing": "0"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "2px"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)"
				}
			}
		}
	}
}
