{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Harbor Lane",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#f6f3ef",
					"name": "Surface"
				},
				{
					"slug": "border-color",
					"color": "#e6e0d9",
					"name": "Border"
				},
				{
					"slug": "foreground",
					"color": "#1d1b1a",
					"name": "Text"
				},
				{
					"slug": "muted-text",
					"color": "#5f5955",
					"name": "Muted Text"
				},
				{
					"slug": "primary",
					"color": "#b3121f",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#2b2a29",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#f0676c",
					"name": "Accent"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #b3121f 0%, #2b2a29 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--foreground)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)",
					"fontWeight": "700",
					"letterSpacing": "0",
					"textTransform": "none"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "0.375rem"
				},
				"typography": {
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)"
				}
			}
		}
	}
}
